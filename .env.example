APP_NAME="Bianlina - Every Seasons Deals"
APP_DESCRIPTION="An online shopping platform for buying and selling products."
APP_ENV=local
APP_KEY=
HASHIDS_SALT=
APP_DEBUG=true
APP_URL=http://buyalot.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=buyalot_cache_

# Note: For cPanel deployment, use 'database' or 'file' cache driver
# Database cache provides better performance on shared hosting
# File cache works well for smaller datasets

MEMCACHED_HOST=127.0.0.1

# Redis configuration (not required for cPanel deployment)
# These settings are kept for local development or VPS deployments
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_ADMIN_ADDRESS=admin@example.com

VITE_APP_NAME="${APP_NAME}"


# Search driver. On shared cPanel hosting use 'database' (no external engine needed).
# Switch to 'meilisearch' only on a VPS/server where a Meilisearch instance is running.
SCOUT_DRIVER=database
MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=
